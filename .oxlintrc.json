{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "env": {
    "node": true,
    "es2022": true
  },
  "settings": {
    "react": {
      "version": "18.2.0"
    }
  },
  "rules": {},
  "overrides": [
    {
      "files": ["test.tsx", "**/*.test.tsx", "**/*.test.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
