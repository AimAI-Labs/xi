{
  "name": "xi",
  "version": "0.0.0",
  "license": "MIT",
  "bin": "dist/cli.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "oxfmt --check && oxlint && tsc --noEmit && ava",
    "test:unit": "ava",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^4.1.0",
    "meow": "^11.0.0",
    "react": "^18.2.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^3.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^18.0.32",
    "ava": "^5.2.0",
    "chalk": "^5.2.0",
    "ink-testing-library": "^3.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.3"
  },
  "ava": {
    "extensions": {
      "ts": "module",
      "tsx": "module"
    },
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
